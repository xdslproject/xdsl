// RUN: MLIR_ROUNDTRIP

// CHECK: %[[I32:.*]] = "test.op"() : () -> i32
%i32 = "test.op"() : () -> i32
// CHECK-NEXT: %[[I64:.*]] = "test.op"() : () -> i64
%i64 = "test.op"() : () -> i64
// CHECK-NEXT: %[[F32:.*]] = "test.op"() : () -> f32
%f32 = "test.op"() : () -> f32
// CHECK-NEXT: %[[F64:.*]] = "test.op"() : () -> f64
%f64 = "test.op"() : () -> f64

// CHECK-NEXT: %{{.*}} = wasmssa.add %[[I32]] %[[I32]] : i32
%i32_sum = wasmssa.add %i32 %i32 : i32
// CHECK-NEXT: %{{.*}} = wasmssa.add %[[I64]] %[[I64]] : i64
%i64_sum = wasmssa.add %i64 %i64 : i64
// CHECK-NEXT: %{{.*}} = wasmssa.add %[[F32]] %[[F32]] : f32
%f32_sum = wasmssa.add %f32 %f32 : f32
// CHECK-NEXT: %{{.*}} = wasmssa.add %[[F64]] %[[F64]] : f64
%f64_sum = wasmssa.add %f64 %f64 : f64
// CHECK-NEXT: %{{.*}} = wasmssa.and %[[I32]] %[[I32]] : i32
%i32_and = wasmssa.and %i32 %i32 : i32
// CHECK-NEXT: %{{.*}} = wasmssa.div %[[F32]] %[[F32]] : f32
%f32_div = wasmssa.div %f32 %f32 : f32
// CHECK-NEXT: %{{.*}} = wasmssa.div_ui %[[I32]] %[[I32]] : i32
%i32_div_ui = wasmssa.div_ui %i32 %i32 : i32
// CHECK-NEXT: %{{.*}} = wasmssa.div_si %[[I32]] %[[I32]] : i32
%i32_div_si = wasmssa.div_si %i32 %i32 : i32
// CHECK-NEXT: %{{.*}} = wasmssa.mul %[[I32]] %[[I32]] : i32
%i32_mul = wasmssa.mul %i32 %i32 : i32
// CHECK-NEXT: %{{.*}} = wasmssa.or %[[I32]] %[[I32]] : i32
%i32_or = wasmssa.or %i32 %i32 : i32
// CHECK-NEXT: %{{.*}} = wasmssa.sub %[[I32]] %[[I32]] : i32
%i32_sub = wasmssa.sub %i32 %i32 : i32
// CHECK-NEXT: %{{.*}} = wasmssa.rem_ui %[[I32]] %[[I32]] : i32
%i32_rem_ui = wasmssa.rem_ui %i32 %i32 : i32
// CHECK-NEXT: %{{.*}} = wasmssa.rem_si %[[I32]] %[[I32]] : i32
%i32_rem_si = wasmssa.rem_si %i32 %i32 : i32
// CHECK-NEXT: %{{.*}} = wasmssa.xor %[[I32]] %[[I32]] : i32
%i32_xor = wasmssa.xor %i32 %i32 : i32
// CHECK-NEXT: %{{.*}} = wasmssa.min %[[F32]] %[[F32]] : f32
%f32_min = wasmssa.min %f32 %f32 : f32
// CHECK-NEXT: %{{.*}} = wasmssa.max %[[F32]] %[[F32]] : f32
%f32_max = wasmssa.max %f32 %f32 : f32
// CHECK-NEXT: %{{.*}} = wasmssa.copysign %[[F32]] %[[F32]] : f32
%f32_copysign = wasmssa.copysign %f32 %f32 : f32
